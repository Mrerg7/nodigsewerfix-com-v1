---
import { ACQUISITION_MAILTO, HERO_IMAGE } from '../config/site';
---

<header class="relative overflow-hidden bg-slate-900">
  <!-- Hero background image -->
  <img
    src={HERO_IMAGE}
    alt="Underground super-sewer tunnel construction and sewer line infrastructure"
    class="absolute inset-0 w-full h-full object-cover"
    fetchpriority="high"
    width="1920"
    height="1080"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-slate-900/75 via-slate-900/60 to-slate-900/85" aria-hidden="true"></div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-6 pt-16 pb-12">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-x-2 bg-white/10 text-white/90 text-xs font-semibold tracking-[1.5px] px-4 h-8 rounded-3xl mb-6 backdrop-blur-sm border border-white/10">
        <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
        <span>PREMIUM EXACT-MATCH .COM DOMAIN</span>
      </div>

      <h1 class="text-5xl md:text-7xl leading-none tracking-tighter font-bold mb-4">
        <span class="domain-name text-white">nodigsewerfix.com</span>
      </h1>

      <p class="text-2xl md:text-3xl text-white/90 font-medium tracking-tight mb-3">
        The perfect brand for modern<br class="hidden md:block" /> trenchless sewer repair companies.
      </p>

      <p class="max-w-lg mx-auto text-lg text-white/70 mb-10">
        Own the exact-match domain that instantly tells homeowners and businesses:
        <span class="font-semibold text-white">"No digging. Professional fix. Fast results."</span>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={ACQUISITION_MAILTO}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-x-3 px-9 h-14 text-lg font-semibold bg-orange-500 hover:bg-orange-600 text-white rounded-3xl cta-button"
        >
          <span>Secure This Domain</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
        <a
          href="#why-perfect"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-x-2 px-8 h-14 text-lg font-semibold border border-white/30 hover:bg-white/10 transition-colors rounded-3xl text-white"
        >
          Why It's Perfect
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm">
        <div class="flex items-center gap-x-2 text-white/70">
          <i class="fa-solid fa-check text-emerald-400"></i>
          <span class="font-medium">Instant brand recognition</span>
        </div>
        <div class="flex items-center gap-x-2 text-white/70">
          <i class="fa-solid fa-check text-emerald-400"></i>
          <span class="font-medium">High commercial intent</span>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 border-t border-white/10 bg-slate-900/60 backdrop-blur-sm py-4">
    <div class="max-w-screen-xl mx-auto px-6">
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-xs uppercase tracking-[1.5px] font-semibold text-white/60">
        <div class="flex items-center gap-x-2">
          <i class="fa-solid fa-globe text-base text-teal-400"></i>
          <span>Exact Match Keywords</span>
        </div>
        <div class="flex items-center gap-x-2">
          <i class="fa-solid fa-shield-halved text-base text-teal-400"></i>
          <span>Premium .COM TLD</span>
        </div>
        <div class="flex items-center gap-x-2">
          <i class="fa-solid fa-bolt text-base text-teal-400"></i>
          <span>Memorable &amp; Brandable</span>
        </div>
        <div class="flex items-center gap-x-2">
          <i class="fa-solid fa-chart-line text-base text-teal-400"></i>
          <span>SEO &amp; Marketing Ready</span>
        </div>
      </div>
    </div>
  </div>
</header>
