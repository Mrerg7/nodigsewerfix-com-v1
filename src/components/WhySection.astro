---
import { getCollection } from 'astro:content';

const benefits = (await getCollection('benefits')).sort((a, b) => a.data.order - b.data.order);
---

<section id="why-perfect" class="max-w-screen-xl mx-auto px-6 pt-16 pb-12">
  <div class="max-w-3xl mx-auto text-center mb-12">
    <div class="inline text-emerald-600 text-sm font-bold tracking-widest">THE STRATEGIC ADVANTAGE</div>
    <h2 class="section-header mt-3 text-balance">
      Why <span class="domain-name">nodigsewerfix.com</span><br />is the ideal domain for sewer re-lining companies
    </h2>
    <p class="mt-4 text-lg text-slate-600">
      In the growing world of trenchless technology, your domain name is your first impression. This one is exceptional.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      benefits.map((benefit) => (
        <div class="benefit-card bg-white p-7 rounded-3xl border border-slate-100 modern-shadow">
          <div class="fact-icon mb-5">
            <i class={`fa-solid ${benefit.data.icon} text-2xl`}></i>
          </div>
          <h3 class="font-semibold text-xl tracking-tight mb-2">{benefit.data.title}</h3>
          <p class="text-slate-600 leading-relaxed">{benefit.body}</p>
          <div class="mt-4 pt-4 border-t text-xs font-medium text-emerald-600 flex items-center gap-x-1.5">
            <i class="fa-solid fa-arrow-trend-up"></i>
            <span>{benefit.data.footnote}</span>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-8 bg-white border border-slate-100 rounded-3xl p-8 md:p-10 flex flex-col md:flex-row gap-8 items-center modern-shadow">
    <div class="flex-1">
      <div class="uppercase tracking-[2px] text-xs font-bold text-orange-600 mb-1">COMPETITIVE EDGE</div>
      <h3 class="text-3xl font-semibold tracking-tight">Own the narrative in a high-growth niche</h3>
      <p class="mt-3 text-slate-600">
        As more municipalities and homeowners demand trenchless methods (lower cost, less disruption, better for the
        environment), this domain gives you an unmatched brand asset that competitors cannot easily replicate.
      </p>
    </div>
    <div class="flex-shrink-0">
      <div class="px-8 py-5 bg-slate-900 text-white rounded-2xl text-center">
        <div class="text-xs tracking-widest opacity-70 mb-1">RARE OPPORTUNITY</div>
        <div class="font-bold text-2xl tracking-tighter">Exact-match<br />"No Dig" domains</div>
        <div class="text-xs mt-3 opacity-60">are extremely limited in the .com space</div>
      </div>
    </div>
  </div>
</section>
