---
import { getCollection } from 'astro:content';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<section id="faq" class="max-w-screen-xl mx-auto px-6 pb-16">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-center text-3xl font-semibold tracking-tight mb-8">
      Frequently Asked Questions About <span class="domain-name">nodigsewerfix.com</span>
    </h2>

    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="group bg-white border border-slate-200 rounded-2xl px-6 py-1 transition-all open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-medium text-lg">
              {faq.data.question}
              <i class="fa-solid fa-chevron-down text-slate-400 transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="pb-5 text-slate-600 text-base leading-relaxed">{faq.body}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>
