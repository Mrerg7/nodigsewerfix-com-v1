---
import { ACQUISITION_MAILTO } from '../config/site';
---

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-screen-xl mx-auto">
    <div class="px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-x-3">
        <div class="w-9 h-9 bg-slate-900 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-tools text-white text-lg"></i>
        </div>
        <span class="font-bold text-xl md:text-2xl tracking-tighter domain-name text-slate-900">nodigsewerfix.com</span>
      </a>

      <div class="hidden md:flex items-center gap-x-8 text-sm font-medium">
        <a href="#why-perfect" class="text-slate-600 hover:text-slate-900 transition-colors">Why This Domain</a>
        <a href="#facts" class="text-slate-600 hover:text-slate-900 transition-colors">The Facts</a>
        <a href="#ideal-for" class="text-slate-600 hover:text-slate-900 transition-colors">Ideal For</a>
        <a href="#faq" class="text-slate-600 hover:text-slate-900 transition-colors">FAQ</a>
      </div>

      <div class="flex items-center gap-x-3">
        <a
          href={ACQUISITION_MAILTO}
          class="inline-flex items-center px-5 py-2.5 text-sm font-semibold bg-orange-500 hover:bg-orange-600 text-white rounded-2xl transition-all cta-button"
        >
          Inquire Now
        </a>

        <button
          id="mobile-menu-btn"
          class="md:hidden w-10 h-10 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-2xl transition-colors"
          aria-label="Toggle menu"
        >
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-6 py-4">
    <div class="flex flex-col gap-y-1 text-sm font-medium">
      <a href="#why-perfect" class="py-2.5 px-3 hover:bg-slate-50 rounded-xl text-slate-600">Why This Domain</a>
      <a href="#facts" class="py-2.5 px-3 hover:bg-slate-50 rounded-xl text-slate-600">The Facts</a>
      <a href="#ideal-for" class="py-2.5 px-3 hover:bg-slate-50 rounded-xl text-slate-600">Ideal For</a>
      <a href="#faq" class="py-2.5 px-3 hover:bg-slate-50 rounded-xl text-slate-600">FAQ</a>
      <a
        href={ACQUISITION_MAILTO}
        class="mt-2 py-2.5 px-3 text-center bg-orange-500 text-white rounded-2xl font-semibold"
      >
        Inquire Now
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const icon = btn.querySelector('i');
    icon?.classList.toggle('fa-bars');
    icon?.classList.toggle('fa-times');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      const icon = btn?.querySelector('i');
      icon?.classList.add('fa-bars');
      icon?.classList.remove('fa-times');
    });
  });

  window.addEventListener('scroll', () => {
    const nav = document.querySelector('nav');
    if (window.scrollY > 20) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  });
</script>
