---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhySection from '../components/WhySection.astro';
import ServiceSection from '../components/ServiceSection.astro';
import FactsSection from '../components/FactsSection.astro';
import IdealForSection from '../components/IdealForSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import FaqSection from '../components/FaqSection.astro';
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
---

<BaseLayout>
