---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import { getCollection } from 'astro:content';
import { SITE, OG_IMAGE, ACQUISITION_MAILTO, DOMAIN_OFFER } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const publishedDate = '2026-07-02';
const modifiedDate = '2026-09-24';
const priceValidUntil = new Date();
priceValidUntil.setFullYear(priceValidUntil.getFullYear() + 1);
const priceValidUntilISO = priceValidUntil.toISOString().split('T')[0];

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.rootUrl}#website`,
      url: SITE.rootUrl,
      name: SITE.name,
      description,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE.rootUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.rootUrl}#webpage`,
      url: SITE.rootUrl,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.rootUrl}#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      datePublished: publishedDate,
      dateModified: modifiedDate,
      inLanguage: 'en-US',
    },
    {
      '@type': 'Product',
      '@id': `${SITE.rootUrl}#product`,
      name: 'nodigsewerfix.com Premium Domain Name',
      description:
        'Exact-match .com domain for trenchless sewer repair, CIPP pipe lining, and no-dig sewer fix companies. Available for acquisition.',
      url: SITE.rootUrl,
      image: [ogImage],
      category: 'Premium Domain Name',
      brand: {
        '@type': 'Brand',
        name: 'nodigsewerfix.com',
      },
      offers: {
        '@type': 'Offer',
        url: ACQUISITION_MAILTO,
        price: DOMAIN_OFFER.price,
        priceCurrency: DOMAIN_OFFER.priceCurrency,
        priceValidUntil: priceValidUntilISO,
        availability: DOMAIN_OFFER.availability,
        itemCondition: DOMAIN_OFFER.itemCondition,
        seller: {
          '@type': 'Organization',
          name: SITE.name,
          email: SITE.email,
        },
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 2,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: '0',
            currency: 'USD',
          },
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          applicableCountry: 'US',
          returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
        },
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.rootUrl}#organization`,
      name: SITE.name,
      url: SITE.rootUrl,
      email: SITE.email,
      logo: `${SITE.rootUrl}apple-touch-icon.png`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'US',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.rootUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.data.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.body.trim(),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="nodigsewerfix.com — Premium Domain for Trenchless Sewer Repair" />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="nodigsewerfix.com — Premium Domain for Trenchless Sewer Repair" />

    <meta name="theme-color" content="#0F172A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      />
    </noscript>

    <link
      rel="preload"
      as="image"
      href="/images/hero-sewer.jpg"
      imagesrcset="/images/hero-sewer-800.jpg 800w, /images/hero-sewer.jpg 1600w"
      imagesizes="100vw"
      fetchpriority="high"
    />

    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
